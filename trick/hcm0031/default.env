# Default trick environment for hcm0031

export SCENE="hcm0031"

# Update these to your local tools before running scripts.
export GS_REPO="/path/to/gaussian-splatting"
export COLMAP_BIN="/path/to/colmap"

# Repo-relative defaults. Override only if your dataset/workspace differs.
export PROJECT_ROOT="/home/thongluc/Khóa Luận Tốt Nghiệp/BTS Digital Twin"
export DATASET_ROOT="$PROJECT_ROOT/Dataset/VAI_NVS_DATA/phase1/public_set"
export WORK_ROOT="$PROJECT_ROOT/pipeline/work"
export MODEL_DIR="$WORK_ROOT/$SCENE/gs_model"
export LOG_DIR="$WORK_ROOT/$SCENE/logs"

# Training defaults
export ITERATIONS="30000"
export SH_DEGREE="3"
export DENSIFY_GRAD_THRESHOLD="0.0002"
export RESOLUTION="-1"
export ANTIALIASING="1"
export EXPOSURE_COMP="1"
export SAVE_FINAL_CHECKPOINT="1"
export PROGRESS_INTERVAL="60"

# B2 pilot defaults
export RUN_DENSE="1"
export RUN_TRAIN="0"
export RUN_RENDER="0"
export RUN_EVAL="0"
export SOURCE_MODE="prepared"

# Sweep defaults
export SWEEP_OUT_DIR="$WORK_ROOT/$SCENE/trick_runs/checkpoint_sweep"
export SWEEP_PSNR_MAX="50.0"
